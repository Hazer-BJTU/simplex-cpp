# Dockerfile.build-portable — the PORTABLE toolchain base image (no sources).
#
# Same role as Dockerfile.build-base, one different goal: artifacts built here
# must RUN on distributions people actually deploy on, not only on the distro
# the image happens to be built from.
#
# ## Why this file exists
#
# Dockerfile.build-base descends from gcc:14.3.0, which is Debian 13 (trixie)
# = glibc 2.41. glibc is backward- but NOT forward-compatible: a binary that
# references GLIBC_2.41 symbols cannot load against an older glibc, so those
# artifacts only run on Ubuntu 25.04+ / Debian 13+ / Fedora 42+ — no LTS
# currently in support. Fine for CI and for testing in-container; unusable as
# a binary release. The glibc floor of the BASE IMAGE is therefore the only
# real lever on how far a release reaches, and it is the reason this image
# starts from an older userland instead.
#
# ## The two decisions encoded here
#
# 1. **Base = AlmaLinux 9 (glibc 2.34).** Reaches RHEL/Alma/Rocky 9+,
#    Ubuntu 22.04+, Debian 12+. It also ships OpenSSL 3.5.5 in AppStream,
#    which matters more than it looks: an AlmaLinux 8 base (glibc 2.28) would
#    reach further, but only carries OpenSSL 1.1.1 — EOL since 2023, and
#    linking it stamps a libssl.so.1.1 SONAME dependency that no current
#    distro provides, breaking compatibility from the other end. Reaching
#    2.28 therefore means building OpenSSL from source too; 2.34 gets a
#    supported system OpenSSL for free.
#
# 2. **Download the previously validated GCC 14.3.0 toolchain.** The
#    gcc-toolchain stage pins the original portable image by immutable digest.
#    Only its compiler, headers and GCC runtime are copied; Boost is rebuilt
#    below with the current component list. Keep that source image published:
#    rebuilding this image requires downloading it, but never bootstraps GCC.
#    Its complete shared libstdc++.so.6 is bundled with releases so C++ types
#    crossing plugin boundaries use one runtime rather than per-DSO static copies.
#
# ## Cost
#
# Downloads the prebuilt compiler and builds Boost/yaml-cpp with JOBS=4 by
# default. There is no GCC source build, even when the local cache is empty.
#
# ## Build (from the repository root — the root .dockerignore governs it)
#
#   docker build -f docker/Dockerfile.build-portable \
#       --build-arg JOBS=4 \
#       -t ghcr.io/hazer-bjtu/simplex-cpp/build-portable:glibc2.34-gcc14.3 \
#       -t ghcr.io/hazer-bjtu/simplex-cpp/build-portable:latest .
#
# Behind a proxy, add --build-arg HTTP_PROXY=... --build-arg HTTPS_PROXY=...
# (BuildKit predefines them, so nothing persists into the image).
#
# Version pins must stay in sync with third_party/versions/*.md and with the
# g++ pin in the top-level CMakeLists.txt.

# Downloaded compiler source, independent of the tag being produced below.
# Do not replace this with latest: that would make the toolchain input mutable.
FROM ghcr.io/hazer-bjtu/simplex-cpp/build-portable@sha256:911758332795a533364858149b8475a4a2a6743de0a11a947e8e89f40d101eb1 AS gcc-toolchain

FROM almalinux:9

ARG JOBS=4

# Runtime + build tooling for the TREE (not for building GCC):
#   openssl-devel  3.5.5, for the asio SSL runtime (no pin by design, see
#                  third_party/versions/README.md)
#   binutils       nm/readelf, required by the llm_plugin_boundary_hygiene ctest
#   cmake          3.31.8 (tree requires >= 3.20)
#   gcc            NOT installed: the only compiler here is the one copied in
#                  below, so there is no distro g++ for PATH to shadow it with
#                  — the trap Dockerfile.build-base has to work around with
#                  explicit aliases does not exist in this image.
#   glibc-devel    the libc HEADERS (features.h, string.h, ...). Easy to lose:
#                  on a normal system these arrive as a dependency of the
#                  distro gcc, which this stage deliberately does not install
#                  — leaving a working compiler that cannot compile #include
#                  <string>. It must be named explicitly.
#   gmp/mpfr/libmpc  runtime halves of GCC's arithmetic prerequisites: the
#                    copied compiler links them, so omitting them leaves a
#                    cc1plus that cannot start
#   diffutils/file/which  minimal-image tooling requirements; Boost's
#                    bootstrap.sh and b2 shell out to them
RUN dnf -y install --setopt=install_weak_deps=False \
        cmake make openssl-devel binutils \
        ca-certificates wget tar bzip2 \
        glibc-devel \
        gmp mpfr libmpc \
        diffutils file which \
    && dnf clean all

# Copy only GCC; the source image's Boost and vendored dependencies are not
# imported. /usr/local/bin in this pinned image contains only GCC executables.
COPY --from=gcc-toolchain /usr/local/bin/ /usr/local/bin/
COPY --from=gcc-toolchain /usr/local/include/c++/ /usr/local/include/c++/
COPY --from=gcc-toolchain /usr/local/lib/gcc/ /usr/local/lib/gcc/
COPY --from=gcc-toolchain /usr/local/libexec/gcc/ /usr/local/libexec/gcc/
COPY --from=gcc-toolchain /usr/local/lib64/ /usr/local/lib64/

# Teach the dynamic loader about /usr/local/lib64 BEFORE anything is compiled:
# the fresh libstdc++.so.6 (GCC 14's, i.e. GLIBCXX_3.4.33) lives there while
# the distro's older one is in /usr/lib64, and the newer must win for anything
# built here to run. This is also the .so to ship alongside release binaries.
RUN echo "/usr/local/lib64" > /etc/ld.so.conf.d/00-gcc-local.conf \
    && echo "/usr/local/lib" >> /etc/ld.so.conf.d/00-gcc-local.conf \
    && ldconfig

# The tree pins CMAKE_CXX_COMPILER to the NAME "g++-14" (top-level
# CMakeLists.txt), so a bare `cmake ..` must resolve that name to THIS
# compiler. gcc-ar/nm/ranlib get the same aliases: CMake resolves
# CMAKE_CXX_COMPILER_AR/RANLIB by the same "-14" name, and an LTO build would
# otherwise feed 14.3.0 bytecode to mismatched plugin tools.
RUN ln -sf g++ /usr/local/bin/g++-14 \
    && ln -sf gcc /usr/local/bin/gcc-14 \
    && ln -sf gcc-ar /usr/local/bin/gcc-ar-14 \
    && ln -sf gcc-nm /usr/local/bin/gcc-nm-14 \
    && ln -sf gcc-ranlib /usr/local/bin/gcc-ranlib-14

# Fail the build loudly if the toolchain is not the one the fingerprint
# expects: a silent drift here would produce artifacts whose admission
# identity differs from Dockerfile.build-base's for no visible reason.
# Second half of the guard: actually COMPILE, LINK and RUN something. The
# version check alone passes on a compiler that cannot find libc headers — the
# exact state this image reaches if glibc-devel is not installed explicitly
# above, since no distro gcc pulls it in here. Failing at this line is cheap;
# failing 40 minutes later inside the Boost build is not.
RUN test "$(g++-14 -dumpfullversion)" = "14.3.0" \
    && g++-14 --version | head -1 \
    && printf '#include <string>\n#include <iostream>\nint main(){std::cout<<std::string("toolchain ok")<<"\\n";}\n' \
        > /tmp/toolchain-check.cpp \
    && g++-14 -std=c++20 /tmp/toolchain-check.cpp -o /tmp/toolchain-check \
    && /tmp/toolchain-check \
    && rm -f /tmp/toolchain-check.cpp /tmp/toolchain-check

# Boost 1.91.0, shared, release variant, exactly the compiled components the
# core tree links (--with-test == unit_test_framework). Building Boost with the
# same compiler as the project is not cosmetic: shared Boost carries C++ types
# across the same DSO boundaries the plugins use.
#
# The compiler is named EXPLICITLY rather than left to b2's autodetection.
# bootstrap.sh's toolset guess probes for a distro-shaped install and finds
# nothing here (this image installs no distro gcc on purpose), so it aborts with
# "Could not find a suitable toolset" despite a perfectly good g++ on PATH.
# Being explicit fixes that and is what we want regardless: the whole premise
# of this image is one known toolchain, so b2 guessing which compiler builds
# Boost is a failure mode even when it guesses right. user-config.jam binds the
# gcc-14.3 toolset to the absolute path of the downloaded compiler; b2 then
# selects it by name.
#
# Installs to /usr/local: headers, libboost_*.so.1.91.0, and the CMake config
# package under /usr/local/lib/cmake/Boost-1.91.0, so find_package(Boost)
# needs no -DBOOST_ROOT.
#
# Integrity: upstream publishes a checksum beside every release file
# (boost_1_91_0.tar.gz.json — sha256 plus the commit the archive was cut from),
# so this digest is quoted from upstream rather than derived here. It is served
# by the same host as the tarball, which bounds what it proves: corruption and a
# re-pushed file are caught, a compromised host is not. Use the .json, not a
# remembered value, when bumping the version.
RUN wget -q -O /tmp/boost.tar.gz \
        https://archives.boost.io/release/1.91.0/source/boost_1_91_0.tar.gz \
    && echo "5734305f40a76c30f951c9abd409a45a2a19fb546efe4162119250bbe4d3a463  /tmp/boost.tar.gz" \
        | sha256sum -c - \
    && tar -xzf /tmp/boost.tar.gz -C /tmp \
    && cd /tmp/boost_1_91_0 \
    && printf 'using gcc : 14.3 : /usr/local/bin/g++-14 ;\n' > /root/user-config.jam \
    && ./bootstrap.sh --with-toolset=gcc --with-libraries=filesystem,process,program_options,test \
    && ./b2 -j${JOBS} toolset=gcc-14.3 \
        link=shared runtime-link=shared variant=release install \
    && ldconfig \
    && rm -rf /tmp/boost.tar.gz /tmp/boost_1_91_0 /root/user-config.jam

# Vendored third parties -> /opt/simplex-thirdparty, mirroring the tree's
# third_party/{include,libs} layout so it is consumed unchanged via
# -DSIMPLEX_THIRDPARTY_DIR=/opt/simplex-thirdparty.
#
# nlohmann/json 3.12.0 — header-only, the release single-header asset.
#
# Integrity: GitHub publishes no digest for release assets (the API's digest
# field is empty for this one), so the value is trust-on-first-use — derived
# from the asset as published, and a pin from here on. The release also ships
# json.hpp.asc, an OpenPGP signature, if this ever needs re-deriving from a
# stronger source than the download itself.
RUN mkdir -p /opt/simplex-thirdparty/include/nlohmann \
    && wget -q -O /opt/simplex-thirdparty/include/nlohmann/json.hpp \
        https://github.com/nlohmann/json/releases/download/v3.12.0/json.hpp \
    && echo "aaf127c04cb31c406e5b04a63f1ae89369fccde6d8fa7cdda1ed4f32dfc5de63  /opt/simplex-thirdparty/include/nlohmann/json.hpp" \
        | sha256sum -c -

# yaml-cpp 0.9.0 — static, built PIC because it reaches MODULE plugin .sos
# through simplex_thirdparty_iface's link directory. The upstream tag is
# "yaml-cpp-0.9.0" (see third_party/versions/yaml-cpp.md), hence the
# doubled directory name. CMAKE_CXX_COMPILER is passed explicitly: a static
# archive linked into plugin .sos must come from the same compiler as
# everything else.
#
# The archive is moved out of lib*/ into libs/ because that is the layout the
# tree's interface target expects. `lib*` matches both spellings on purpose:
# CMake's GNUInstallDirs resolves LIBDIR to lib64 on RHEL-family distros and
# lib on Debian, so hardcoding either makes this step distro-specific for no
# reason. The trailing test turns a silent miss into a build failure.
#
# Integrity: the archive is generated by GitHub from a lightweight tag — there
# is no signed release asset and no published digest for archives — so this is
# trust-on-first-use like the json.hpp pin above, and the pin is the only thing
# that makes the downloaded bytes reviewable at all. The consequence is specific
# and acceptable: if GitHub ever changes how it packs archives, the build fails
# loudly here and someone re-derives the value from the same tag, which is a
# reviewable edit rather than a silent toolchain change.
RUN wget -q -O /tmp/yaml-cpp.tar.gz \
        https://github.com/jbeder/yaml-cpp/archive/refs/tags/yaml-cpp-0.9.0.tar.gz \
    && echo "25cb043240f828a8c51beb830569634bc7ac603978e0f69d6b63558dadefd49a  /tmp/yaml-cpp.tar.gz" \
        | sha256sum -c - \
    && tar -xzf /tmp/yaml-cpp.tar.gz -C /tmp \
    && cmake -S /tmp/yaml-cpp-yaml-cpp-0.9.0 -B /tmp/yaml-cpp-build \
        -DCMAKE_CXX_COMPILER=g++-14 \
        -DCMAKE_BUILD_TYPE=Release \
        -DYAML_BUILD_SHARED_LIBS=OFF \
        -DYAML_CPP_BUILD_TESTS=OFF \
        -DYAML_CPP_BUILD_TOOLS=OFF \
        -DYAML_CPP_BUILD_CONTRIB=OFF \
        -DCMAKE_POSITION_INDEPENDENT_CODE=ON \
        -DCMAKE_INSTALL_PREFIX=/opt/simplex-thirdparty \
    && cmake --build /tmp/yaml-cpp-build -j${JOBS} \
    && cmake --install /tmp/yaml-cpp-build \
    && mkdir -p /opt/simplex-thirdparty/libs \
    && mv /opt/simplex-thirdparty/lib*/libyaml-cpp.a \
        /opt/simplex-thirdparty/libs/ \
    && rm -rf /opt/simplex-thirdparty/lib /opt/simplex-thirdparty/lib64 \
        /tmp/yaml-cpp.tar.gz /tmp/yaml-cpp-yaml-cpp-0.9.0 /tmp/yaml-cpp-build \
    && test -f /opt/simplex-thirdparty/libs/libyaml-cpp.a

# The C++ runtime to ship next to release binaries. Collected in one place so
# a release step is `cp /opt/simplex-runtime/* <staging>/lib/` rather than a
# hunt through /usr/local/lib64 — and so what the release depends on is
# recorded in the image instead of in someone's notes.
RUN mkdir -p /opt/simplex-runtime \
    && cp -P /usr/local/lib64/libstdc++.so.6* /opt/simplex-runtime/ \
    && cp -P /usr/local/lib64/libgcc_s.so.1* /opt/simplex-runtime/ \
    && cp -P /usr/local/lib/libboost_*.so* /opt/simplex-runtime/

LABEL org.opencontainers.image.title="simplex-cpp build-portable" \
      org.opencontainers.image.description="Portable toolchain base for building redistributable simplex-cpp binaries: AlmaLinux 9 (glibc 2.34), GCC 14.3.0 from a pinned prebuilt image, Boost 1.91.0 shared, OpenSSL 3.5, vendored nlohmann/json + yaml-cpp" \
      org.opencontainers.image.source="https://github.com/Hazer-BJTU/simplex-cpp" \
      simplex.build.gcc="14.3.0" \
      simplex.build.gcc-origin="prebuilt-image" \
      simplex.build.glibc="2.34" \
      simplex.build.distro="almalinux9" \
      simplex.build.boost="1.91.0" \
      simplex.build.nlohmann-json="3.12.0" \
      simplex.build.yaml-cpp="0.9.0"
