# Build and prepare the musl package with host-compatible Boost.Test monitoring.
ARG BUILD_IMAGE=simplex-build-musl:experimental
FROM ${BUILD_IMAGE} AS build
ARG JOBS=2
# The published base predates this Boost.Test fix. Rebuild only its test
# library; no worker production dependency or public entry point changes.
COPY docker/boost-test-musl-alt-stack.patch /tmp/boost-test-musl-alt-stack.patch
RUN wget -q -O /tmp/boost.tar.gz \
        https://archives.boost.io/release/1.91.0/source/boost_1_91_0.tar.gz \
    && echo "5734305f40a76c30f951c9abd409a45a2a19fb546efe4162119250bbe4d3a463  /tmp/boost.tar.gz" | sha256sum -c - \
    && tar -xzf /tmp/boost.tar.gz -C /tmp \
    && cd /tmp/boost_1_91_0 \
    && patch -p1 < /tmp/boost-test-musl-alt-stack.patch \
    && ./bootstrap.sh --with-libraries=test \
    && ./b2 -j"${JOBS}" --with-test link=shared runtime-link=shared variant=release install \
    && cp -a /usr/local/lib/libboost_unit_test_framework.so* /opt/simplex-runtime/ \
    && rm -rf /tmp/boost.tar.gz /tmp/boost_1_91_0 /tmp/boost-test-musl-alt-stack.patch
WORKDIR /src
COPY . .
# Also support incremental experiments based on a previous test image.
COPY docker/musl-licenses /opt/simplex-runtime-licenses
RUN cmake -S /src -B /build -G Ninja \
        -DCMAKE_CXX_COMPILER=g++ -DCMAKE_BUILD_TYPE=Release \
        -DSIMPLEX_ENABLE_LTO=OFF \
        -DSIMPLEX_THIRDPARTY_DIR=/opt/simplex-thirdparty \
        -DSIMPLEX_BUNDLE_RUNTIME=/opt/simplex-runtime \
        -DCMAKE_INSTALL_PREFIX=/opt/simplex \
    && cmake --build /build -j"${JOBS}"
# Keep failing test diagnostics in an inspectable build image. Tests are run
# explicitly after the image builds, rather than discarded in a failed layer.
RUN if [ -d /opt/simplex ]; then rm -r /opt/simplex; fi \
    && cmake --install /build --strip \
    && bash /src/docker/prepare-musl-runtime.sh /opt/simplex
RUN g++ -std=c++20 -I/opt/simplex-thirdparty/include \
        /src/docker/musl-launch-probe.cpp -o /src/docker/musl-launch-probe
