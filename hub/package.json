{
  "name": "@hazer-bjtu/simplex-hub",
  "version": "1.2.1",
  "description": "Worker hub and web panel for simplex_worker sessions",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hazer-BJTU/simplex-cpp.git",
    "directory": "hub"
  },
  "homepage": "https://github.com/Hazer-BJTU/simplex-cpp/tree/main/hub",
  "bugs": "https://github.com/Hazer-BJTU/simplex-cpp/issues",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "simplex-hub": "./dist/bin/simplex-hub.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node bin/simplex-hub.ts",
    "dev": "node --watch bin/simplex-hub.ts",
    "dev:panel": "vite",
    "build": "vite build",
    "build:release": "npm run build && node scripts/stage-release.mjs --prepare && tsc -p tsconfig.release.json && tsc -p tsconfig.ui.release.json && node scripts/finalize-ui-declarations.mjs && node scripts/stage-release.mjs",
    "version:check": "node ../versioning/sync_version.mjs --check",
    "version:sync": "node ../versioning/sync_version.mjs --write",
    "typecheck": "tsc -p tsconfig.json && tsc -p web/tsconfig.json && tsc -p test/browser/tsconfig.json && npm run check:ui",
    "test": "node --test test/*.test.js",
    "test:e2e": "node --test --test-concurrency=1 test/e2e/*.test.js",
    "check:panel": "node test/browser/real-hub-check.mjs",
    "check:ui": "tsc -p tsconfig.ui.json && node scripts/check-ui-boundary.mjs"
  },
  "dependencies": {
    "tar": "^7.5.22",
    "undici": "^7.30.0",
    "ws": "^8.18.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@babel/parser": "^8.0.7",
    "@playwright/test": "^1.63.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "ajv": "^8.20.0",
    "highlight.js": "^11.12.0",
    "lowlight": "3.3.0",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "zustand": "^5.0.15"
  },
  "exports": {
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js"
    }
  }
}
