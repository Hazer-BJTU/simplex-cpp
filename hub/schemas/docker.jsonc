{
    // Worker inside an already running container.
    //
    // The Hub never builds, starts, stops or removes a container. Create one
    // yourself, keep it running, and install the same `simplex` command inside
    // it. The Hub only runs `simplex manage` and `simplex run` there through
    // `docker exec`; see docs/deployment/docker-worker.md.
    "management": {
        "target": {
            "kind": "docker",
            // Docker CLI and global options (for example a --context). Never an
            // image, a `run` command or a container lifetime flag.
            "command": "docker",
            "args": [],
            // Stable name of the operator-retained container. It must remain
            // running through worker shutdown and allocation removal.
            "container": "simplex-worker",
            // Read-only startup checks; omitted fields use the values shown.
            "preflight": {
                "enabled": true,
                // Deadline for one Docker CLI call.
                "timeoutMs": 5000,
                // Require a running container (it must exist either way)...
                "container": true,
                // ...with this installation usable inside it...
                "executable": true,
                // ...whose network can reach the advertised Hub channel.
                "endpoint": { "enabled": true, "channels": ["events"] }
            }
        },
        // Installed inside the container: PATH lookup or an absolute path.
        "executable": "simplex",
        // Hub-local working directory and environment for the Docker CLI.
        "cwd": "__HUB_CWD__",
        "env": {},
        // Container-local allocation root. It must be writable by the
        // container user, is durable only while the container lives, and
        // should be mounted if the container may be recreated.
        "root": "/var/lib/simplex/allocations",
        "timeoutMs": 30000
    },
    "worker": {
        "threads": 1,
        // Address reachable from the container. The default bridge gateway is
        // 172.17.0.1; with --add-host=host.docker.internal:host-gateway use
        // host.docker.internal instead.
        "connectHost": "172.17.0.1",
        "stopTimeoutMs": 15000,
        "sigtermGraceMs": 5000,
        "sigkillGraceMs": 2000
    },
    "env": {},
    "endpoints": {}
}
