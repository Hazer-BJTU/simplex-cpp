{
    // Runs on the Hub host through the target-side manager. Set management.executable
    // to an absolute simplex router when it is not on PATH. Both run and manage
    // use that same installation. Existing saved launch files are never rewritten.
    // The launcher command is retained for compatibility; management takes precedence.
    "launcher": {
        "kind": "command",
        "command": [
            "simplex", "run",
            "--config", "{config}",
            "--session", "{session}",
            "--threads", "{threads}"
        ],
        "args": [],
        // Legacy launcher field. management.cwd controls managed local starts.
        "cwd": "",
        "pidFile": ""
    },
    "management": {
        "target": { "kind": "local" },
        "executable": "simplex",
        // Hub-local working directory/environment for run and manage.
        "cwd": "__HUB_CWD__",
        "env": {},
        // Separate from Hub data; each session gets an independent allocation UUID.
        "root": "__WORKER_ROOT__",
        "timeoutMs": 30000
    },
    "worker": {
        "threads": 1,
        // Empty: use the live Hub listener. For a container, enter the host
        // address reachable from the container, e.g. "172.17.0.1".
        "connectHost": "",
        "stopTimeoutMs": 15000,
        "sigtermGraceMs": 5000,
        "sigkillGraceMs": 2000
    },
    // The child inherits the Hub environment; these entries override it.
    "env": {},
    // Optional per-channel advertised origins (ws:// or wss://), including a
    // reverse-proxy prefix. Session routes and tokens are appended by the Hub.
    // Example: "events": "wss://hub.example/worker"
    // Channel keys: events, confirm, tools. Tools uses its own listener port.
    "endpoints": {}
}
