{
    // Copy to hub.config.jsonc (or pass --config) and edit.
    // Comments are allowed; the reader strips them before parsing, and the
    // file stays valid JSON without them. Relative paths resolve against this
    // file's directory. See hub/README.md for every field.
    "listen": { "host": "127.0.0.1", "port": 8800 },
    // Omit dataDir to use ~/.simplex/hub. Set an absolute path to relocate it.

    // Empty token disables panel authentication. A non-loopback listen address
    // requires one: a payload channel is an approval authority
    // (core/docs/worker-protocol.md).
    "panel": { "token": "" },

    // Independent worker RPC listener. Empty host inherits listen.host.
    // Plan read/replace routes are implemented; unknown routes are rejected.
    "toolRequests": { "host": "", "port": 8801, "timeoutMs": 120000, "maxConnections": 128 },

    "worker": {
        // Relative to this file; the default assumes an in-tree build tree.
        "bin": "../build/bin/simplex_worker",
        // Relative to the worker's installation directory, which is where the
        // worker looks for it; the hub never rewrites it into a local path.
        "systemPromptFile": "prompts/coding_agent.yaml",
        "threads": 1,
        "maxExchanges": 512,
        "eventCapacity": 1024,
        "confirmationTimeoutMs": 120000,
        // Enable hub-backed tools such as plan in new sessions.
        "hubRemoteCall": true,
        // Copied into every generated worker config; these are the worker's own
        // defaults from core/docs/worker-protocol.md.
        "payloadCapacity": 256,
        "signalCapacity": 256,
        "writeCapacity": 256,
        "initialBackoffMs": 250,
        "maxBackoffMs": 10000,
        "idleTimeoutSeconds": 0,
        // How long a graceful stop may take before the hub escalates.
        "stopTimeoutMs": 15000,
        // Grace periods for the escalating stop: SIGTERM first, then SIGKILL.
        "sigtermGraceMs": 5000,
        "sigkillGraceMs": 2000,
        "persistence": { "enabled": true, "readable": false },
        // Copied to new worker configs as persistence.memory_retention.
        // Applied after successful compact; the current archive is kept.
        // Zero disables cleanup.
        "memoryRetention": { "maxArchives": 5 },
        "environment": { "workspace": "", "platform": "", "software": [] }
    },

    // Provider entries are copied verbatim into the worker configuration the
    // hub generates; the session picks one by name as its driver_model.
    // ${NAME} is expanded by the worker at startup, so no secret reaches disk.
    "providerProfiles": {
        "deepseek": {
            "plugin": "deepseek",
            "model": "deepseek-flash",
            "config": { "reasoning": { "effort": "high" } },
            "endpoint": {
                "base_url": "https://api.deepseek.com",
                "auth": { "scheme": "bearer", "api_key": "${DEEPSEEK_API_KEY}" }
            },
            "retry": { "max_attempts": 3, "initial_backoff_ms": 500, "max_backoff_ms": 120000 }
        },
        "mock": {
            "plugin": "deepseek",
            "model": "mock-flash",
            "endpoint": { "base_url": "http://127.0.0.1:0", "auth": { "scheme": "none" } },
            "retry": { "max_attempts": 0 }
        }
    },

    "launcher": {
        // "simplex-worker": run worker.bin with --config/--session/--threads.
        // "command": run launcher.command as a template with the placeholders
        // {session}, {config}, {data_dir}, {session_dir}, {endpoint},
        // {confirm_endpoint}. Use it for a wrapper script or the
        // installed `simplex run ...` entry point.
        "kind": "simplex-worker",
        "command": [],
        "args": [],
        // The hub creates and refreshes sessions/<id>/config/config.yaml
        // for every launcher.
        // Working directory for the spawned command; empty means the
        // per-session hub directory.
        "cwd": "",
        // Only for a launcher that daemonizes: absolute path of the pid file
        // the supervisor should signal instead of the spawned process.
        "pidFile": ""
    },

    // Offline model provider for demos and end-to-end tests: no API key needed.
    // The scenario is chosen by the model name a session asks for
    // (mock-flash/mock-auto, mock-text, mock-echo, mock-slow, mock-error).
    "mock": {
        "enabled": false,
        "listen": "127.0.0.1:0",
        "profile": "mock",
        "scenario": "auto",
        "slowMs": 1500
    },

    "limits": {
        // In-memory budgets per session (entry count plus a byte ceiling).
        "transcriptEvents": 5000,
        "transcriptBytes": 33554432,
        "logLines": 500,
        "logRingBytes": 262144,
        // On-disk worker log rotation.
        "logBytes": 8388608,
        "logFiles": 2,
        "maxMessageBytes": 33554432,
        // Server-side ping interval for worker connections; zero disables it.
        "pingIntervalMs": 30000,
        "confirmIdentityHoldMs": 15000
    },

    // Off by default. See hub/README.md ("stopping a worker") for what a
    // process-group kill does and does not cover.
    "forceKillProcessGroup": false
}
