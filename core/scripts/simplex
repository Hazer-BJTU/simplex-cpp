#!/usr/bin/env bash
# Public command router. Keep worker argument parsing in the C++ executable.
set -euo pipefail

usage() {
    cat <<'HELP'
Usage: simplex <command> [options]

Commands:
  run       Start a worker session
  manage    Manage worker allocations on this host
  protocol  Print the compiled worker protocol (--hash for SHA-256 only)

Use "simplex run --help" for worker options.
Use "simplex --version" to show the compiled worker version.
HELP
}

executable=simplex_worker
kind=worker
case "${1:-}" in
    ''|-h|--help)
        usage
        exit 0
        ;;
    run)
        shift
        ;;
    protocol)
        shift
        if (( $# == 0 )); then
            set -- --protocol
        elif (( $# == 1 )) && [[ "$1" == --hash ]]; then
            set -- --protocol-hash
        elif (( $# == 1 )) && [[ "$1" == -h || "$1" == --help ]]; then
            printf 'Usage: simplex protocol [--hash]\n'
            exit 0
        else
            printf 'Usage: simplex protocol [--hash]\n' >&2
            exit 2
        fi
        ;;
    manage)
        executable=simplex_manager
        kind=manager
        shift
        ;;
    --version)
        # Keep the flag for the worker, which owns the compiled version.
        ;;
    *)
        printf 'simplex: unknown command: %s\n\n' "$1" >&2
        usage >&2
        exit 2
        ;;
esac

# Follow launcher symlinks without changing the caller's working directory.
# This also keeps executable-relative plugin and prompt discovery in the worker.
launcher=${BASH_SOURCE[0]}
links=0
while [[ -L "$launcher" ]]; do
    if (( links >= 40 )); then
        printf 'simplex: too many launcher symbolic links\n' >&2
        exit 126
    fi
    links=$((links + 1))
    directory=$(cd -P -- "$(dirname -- "$launcher")" && pwd)
    launcher=$(readlink -- "$launcher")
    if [[ "$launcher" != /* ]]; then
        launcher="$directory/$launcher"
    fi
done

directory=$(cd -P -- "$(dirname -- "$launcher")" && pwd)
worker="$directory/$executable"
if [[ ! -f "$worker" || ! -x "$worker" ]]; then
    printf 'simplex: %s executable is missing or not executable: %s\n' "$kind" "$worker" >&2
    exit 127
fi

# No intermediate shell process survives: the worker receives signals directly.
exec "$worker" "$@"
